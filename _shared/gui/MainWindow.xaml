<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Game Servers"
    Width="640" Height="860"
    MinWidth="480" MinHeight="520"
    ResizeMode="CanResize"
    WindowStartupLocation="CenterScreen"
    Background="#1B211C">

    <!-- Shell: one Window, three swappable screen hosts (only one visible at
         a time, Home/ManageMaps/AddServer used to be separate popup windows)
         plus an overlay host for small prompts (rename/confirm/browse),
         layered on top instead of opening yet another window. -->
    <Grid>
        <ContentControl x:Name="HomeHost" Focusable="False"/>
        <ContentControl x:Name="MapsHost" Focusable="False" Visibility="Collapsed"/>
        <ContentControl x:Name="AddServerHost" Focusable="False" Visibility="Collapsed"/>
        <ContentControl x:Name="ConsoleHost" Focusable="False" Visibility="Collapsed"/>
        <ContentControl x:Name="SettingsHost" Focusable="False" Visibility="Collapsed"/>
        <ContentControl x:Name="OverlayHost" Focusable="False" Visibility="Collapsed" Panel.ZIndex="10"/>
    </Grid>
</Window>
