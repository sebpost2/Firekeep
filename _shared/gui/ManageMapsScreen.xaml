<Grid
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Margin="28">

    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Button Grid.Column="0" x:Name="BackButton" Content="&#xE72B;" Style="{StaticResource BackButtonStyle}" Margin="0,0,8,0"/>
        <TextBlock Grid.Column="1" x:Name="TitleText" Text="MANAGE MAPS" Foreground="{StaticResource TextBrush}"
                   FontFamily="Segoe UI Black" FontSize="22" VerticalAlignment="Center"/>
    </Grid>
    <TextBlock Grid.Row="1" x:Name="SubtitleText" Text="" Foreground="{StaticResource MutedTextBrush}"
               FontFamily="Segoe UI" FontSize="12" Margin="40,4,0,18"/>

    <ListBox Grid.Row="2" x:Name="WorldsList" Background="Transparent" BorderThickness="0"
              ItemTemplate="{StaticResource WorldItemTemplate}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>

    <TextBlock Grid.Row="3" x:Name="HintText" Text=" " Foreground="{StaticResource MutedTextBrush}"
               FontFamily="Segoe UI" FontSize="11" Margin="0,12,0,12"/>

    <WrapPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center">
        <Button x:Name="SwitchButton" Content="Switch active" Style="{StaticResource ToolButtonStyle}"/>
        <Button x:Name="NewButton" Content="New world" Style="{StaticResource ToolButtonStyle}"/>
        <Button x:Name="ImportButton" Content="Import .zip" Style="{StaticResource ToolButtonStyle}"/>
        <Button x:Name="DeleteButton" Content="Send to trash" Style="{StaticResource ToolButtonStyle}"
                Background="{StaticResource DangerBrush}" Foreground="{StaticResource TextBrush}"
                Tag="{StaticResource DangerHoverBrush}"/>
        <Button x:Name="TrashToggleButton" Content="View trash" Style="{StaticResource ToolButtonStyle}" Margin="0,0,0,8"/>
    </WrapPanel>
</Grid>
