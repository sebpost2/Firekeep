<Grid
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Margin="20">

    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Button Grid.Column="0" x:Name="BackButton" Content="&#xE72B;" Style="{StaticResource BackButtonStyle}" Margin="0,0,8,0"/>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="ADD SERVER" Foreground="{StaticResource TextBrush}"
                       FontFamily="Segoe UI Black" FontSize="20"/>
            <TextBlock Text="Set up a new world in a few clicks" Foreground="{StaticResource MutedTextBrush}"
                       FontFamily="Segoe UI" FontSize="12" Margin="0,2,0,0"/>
        </StackPanel>
    </Grid>

    <TextBlock Grid.Row="1" Text="Server name" Style="{StaticResource LabelStyle}"/>
    <TextBox Grid.Row="2" x:Name="NameBox"/>

    <TextBlock Grid.Row="3" Text="Modpack - optional" Style="{StaticResource LabelStyle}"/>
    <Grid Grid.Row="4" x:Name="ModpackDropZone" AllowDrop="True" MinHeight="92">
        <Rectangle x:Name="DropZoneOutline" RadiusX="8" RadiusY="8" Fill="{StaticResource PanelBrush}"
                   Stroke="{StaticResource BorderSubtleBrush}" StrokeThickness="1.5" StrokeDashArray="4 3"/>

        <StackPanel x:Name="DropZoneEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12">
            <TextBlock x:Name="DropZoneIcon" Text="&#128230;" FontSize="24" HorizontalAlignment="Center" Opacity="0.7"/>
            <TextBlock x:Name="DropZoneTitle" Text="Drag a modpack here" Foreground="{StaticResource TextBrush}"
                       FontFamily="Segoe UI Semibold" FontSize="13" HorizontalAlignment="Center" Margin="0,6,0,2"/>
            <TextBlock Text=".mrpack or CurseForge .zip" Foreground="{StaticResource MutedTextBrush}"
                       FontFamily="Segoe UI" FontSize="11" HorizontalAlignment="Center"/>
            <Button x:Name="BrowseButton" Content="or browse..." Style="{StaticResource LinkButtonStyle}" Margin="0,4,0,0" HorizontalAlignment="Center"/>
        </StackPanel>

        <Grid x:Name="DropZoneFilledState" Visibility="Collapsed" Margin="16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock x:Name="DropZoneFileName" Text="" Foreground="{StaticResource TextBrush}"
                           FontFamily="Consolas" FontSize="12" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="DropZoneFileType" Text="" Foreground="{StaticResource MutedTextBrush}"
                           FontFamily="Segoe UI" FontSize="11" Margin="0,2,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" x:Name="ClearModpackButton" Content="Remove" Style="{StaticResource LinkButtonStyle}" VerticalAlignment="Center"/>
        </Grid>

        <TextBox x:Name="MrpackBox" Visibility="Collapsed"/>
    </Grid>

    <TextBlock Grid.Row="5" Text="Max memory (e.g. 6G)" Style="{StaticResource LabelStyle}"/>
    <TextBox Grid.Row="6" x:Name="RamBox" Text="6G"/>

    <CheckBox Grid.Row="7" x:Name="EulaCheck" Margin="0,14,0,0" Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI" FontSize="12">
        <TextBlock Text="I have read and accept the Minecraft EULA (aka.ms/MinecraftEULA)" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}"/>
    </CheckBox>

    <TextBlock Grid.Row="9" x:Name="HintText" Text=" " Foreground="{StaticResource MutedTextBrush}"
               FontFamily="Segoe UI" FontSize="12" Margin="0,10,0,10" TextWrapping="Wrap"/>

    <Button Grid.Row="10" x:Name="CreateButton" Content="CREATE SERVER" Style="{StaticResource ActionButtonStyle}"/>
</Grid>
